# Copy to api/.env and run npm run start:payments. Never commit .env.
# Demo remains the default. Only the admin's saved switch enables paid checkout.
# Optional deployment defaults. Merchant fields can also be entered in Admin.
PAYMENT_ENV=sandbox
# Optional 32-byte encryption key (64 hex chars or base64). If blank, uses data/payment-config.key.
PAYMENT_CONFIG_KEY=
# Public HTTPS origin serving frontend + /api/arena. No trailing path/query.
PAYMENT_PUBLIC_URL=

# Merchant credentials from each provider. Leave unconfigured methods blank.
# Use environment-specific prefixes so callbacks for old orders remain verifiable.
MOMO_SANDBOX_PARTNER_CODE=
MOMO_SANDBOX_ACCESS_KEY=
MOMO_SANDBOX_SECRET_KEY=
MOMO_LIVE_PARTNER_CODE=
MOMO_LIVE_ACCESS_KEY=
MOMO_LIVE_SECRET_KEY=

ZALOPAY_SANDBOX_APP_ID=
ZALOPAY_SANDBOX_KEY1=
ZALOPAY_SANDBOX_KEY2=
ZALOPAY_LIVE_APP_ID=
ZALOPAY_LIVE_KEY1=
ZALOPAY_LIVE_KEY2=

SHOPEEPAY_SANDBOX_CLIENT_ID=
SHOPEEPAY_SANDBOX_SECRET_KEY=
SHOPEEPAY_SANDBOX_MERCHANT_ID=
SHOPEEPAY_SANDBOX_STORE_ID=
SHOPEEPAY_LIVE_CLIENT_ID=
SHOPEEPAY_LIVE_SECRET_KEY=
SHOPEEPAY_LIVE_MERCHANT_ID=
SHOPEEPAY_LIVE_STORE_ID=

# payOS only has a Live API. It is intentionally unavailable in Sandbox.
PAYOS_LIVE_CLIENT_ID=
PAYOS_LIVE_API_KEY=
PAYOS_LIVE_CHECKSUM_KEY=

PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
# Merchant-configured integer VND per USD; no exchange rate is guessed.
PAYPAL_SANDBOX_VND_PER_USD=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_VND_PER_USD=
